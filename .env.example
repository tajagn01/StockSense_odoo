# ==========================================
# StockSense Environment Configuration Template
# ==========================================

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/stocksense?schema=public"

# Authentication (Auth.js / NextAuth)
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration (SMTP for OTPs & Password Resets)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="StockSense <noreply@stocksense.local>"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
